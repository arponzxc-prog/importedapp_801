<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <include android:id="@+id/loginRoot" layout="@layout/layout_login" />

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include android:id="@+id/pageHome" layout="@layout/page_home" />
            <include android:id="@+id/pageSettings" layout="@layout/page_settings" />
            <include android:id="@+id/pageSms" layout="@layout/page_sms" />
        </FrameLayout>

        <com.ishan.sms.BrandFooterView
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFFFF"
            android:elevation="0dp"
            app:itemIconTint="@color/nav_tint"
            app:itemTextColor="@color/nav_tint"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</FrameLayout>

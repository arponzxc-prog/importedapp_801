<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp">

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="SMS READER"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="SMS READER"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="শুরু করতে অ্যাডমিন প্যানেলের Key দিয়ে\nপ্রথম প্রজেক্ট যোগ করুন"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddFirst"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="প্রজেক্ট যোগ করুন"
            android:textSize="16sp"
            app:backgroundTint="@color/purple"
            app:cornerRadius="18dp" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <com.ishan.sms.BrandFooterView
            android:layout_width="match_parent"
            android:layout_height="32dp" />
    </LinearLayout>
</ScrollView>

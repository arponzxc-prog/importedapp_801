<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="8dp" android:paddingEnd="24dp">
        <EditText android:id="@+id/etPName" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="প্রজেক্টের নাম (যেমন: RH Esports)" android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="#FFA9A4C4" android:textSize="15sp" />
        <LinearLayout android:id="@+id/boxConn" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <EditText android:id="@+id/etPUrl" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Database URL (https://xxxx.firebaseio.com)" android:inputType="textUri" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="#FFA9A4C4" android:textSize="15sp" />
        <EditText android:id="@+id/etPKey" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="Reader Key (RH-XXXXX-...)" android:inputType="textNoSuggestions|textVisiblePassword" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="#FFA9A4C4" android:textSize="15sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="কোন SIM-এর SMS এই প্রজেক্টে যাবে?" android:textColor="@color/muted" android:textSize="13sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgSim" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbAny" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="যেকোনো" />
            <RadioButton android:id="@+id/rbSim1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SIM 1" />
            <RadioButton android:id="@+id/rbSim2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SIM 2" />
        </RadioGroup>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="কোন মেথড? (কিছু না বাছলে সব মেথড)" android:textColor="@color/muted" android:textSize="13sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <CheckBox android:id="@+id/cbBkash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="bKash" />
            <CheckBox android:id="@+id/cbNagad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nagad" />
            <CheckBox android:id="@+id/cbRocket" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rocket" />
        </LinearLayout>
        <TextView android:id="@+id/tvPMsg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:textColor="#FFC2255C" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
